---
/**
 * Pricing.
 *
 * `PLANS` is empty on purpose: no tier, price, or limit has been decided, and
 * PRODUCT.md records that pricing must not be invented. While it is empty the
 * section renders an honest interim block. Fill the array and the same section
 * renders the comparison grid — adding pricing later is editing one list, not
 * rebuilding a section.
 */
import { whatsappHref } from "../data/site";

interface Plan {
  name: string;
  price: string;
  cadence: string;
  /** One line on who this tier is for. */
  fit: string;
  includes: string[];
  featured?: boolean;
}

const PLANS: Plan[] = [];
---

<section class="planes" id="planes">
  <div class="planes-head">
    <h2 class="sign planes-title">Planes</h2>
    <p class="planes-lede prose-line">
      Van por volumen de conversaciones y cantidad de agentes.
    </p>
  </div>

  {
    PLANS.length > 0 ? (
      <ul class="planes-grid">
        {PLANS.map((plan) => (
          <li class={plan.featured ? "plan glass plan--featured" : "plan glass"}>
            <h3 class="sign-sm plan-name">{plan.name}</h3>
            <p class="plan-price">
              <span class="plan-amount tabular">{plan.price}</span>
              <span class="plan-cadence note">{plan.cadence}</span>
            </p>
            <p class="plan-fit note">{plan.fit}</p>
            <ul class="plan-list">
              {plan.includes.map((item) => (
                <li>
                  <span class="plan-tick" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    ) : (
      <div class="planes-soon glass">
        <p class="planes-soon-line">
          Dinos cuántos agentes y cuántas conversaciones manejas por mes y te
          pasamos el número.
        </p>
        <a class="planes-soon-link brand-button" href={whatsappHref} rel="noopener">
          Pedir precio por WhatsApp
        </a>
      </div>
    )
  }
</section>

<style>
  .planes {
    display: grid;
    gap: 1.75rem;
    padding-block: clamp(2.75rem, 6vh, 4.25rem) clamp(2rem, 4vh, 3rem);
  }

  .planes-head {
    display: grid;
    gap: 0.85rem;
  }

  .planes-title {
    margin: 0;
    font-size: clamp(1.75rem, 4.2vw, 3rem);
    color: var(--color-bone);
  }

  .planes-lede {
    margin: 0;
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    color: var(--color-bone-dim);
  }

  /* ---- Interim state -------------------------------------------------- */

  .planes-soon {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding: clamp(1.4rem, 3vw, 2rem);
    max-width: 44rem;
  }

  .planes-soon-line {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-bone-dim);
    max-width: 56ch;
  }

  .planes-soon-link {
    padding: 0.8rem 1.25rem;
    font-weight: 600;
    font-size: 0.9375rem;
    border-radius: var(--radius-pill);
  }

  /* ---- Filled state --------------------------------------------------- */

  .planes-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .plan {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .plan--featured {
    border-color: color-mix(in oklab, var(--color-leaf) 45%, transparent);
    box-shadow:
      inset 0 1px 0 0 rgb(232 240 228 / 0.09),
      0 0 34px -12px color-mix(in oklab, var(--color-emerald) 70%, transparent);
  }

  .plan-name {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--color-bone);
  }

  .plan-price {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .plan-amount {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    color: var(--color-lime);
    letter-spacing: -0.02em;
  }

  .plan-fit {
    margin: 0;
  }

  .plan-list {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-bone-dim);
  }

  .plan-list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .plan-tick {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--color-leaf);
  }

  @media (min-width: 52rem) {
    .planes-grid {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }
</style>
