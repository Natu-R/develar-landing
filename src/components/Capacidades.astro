---
/**
 * What you get. Four blocks, each one alternating its demonstration so the
 * scroll keeps a rhythm instead of stacking four identical cards.
 *
 * Three lines per block and no paragraph: a landing is scanned, and the demo
 * beside each block does the explaining a paragraph was trying to do.
 */
import { CAPABILITIES } from "../data/capabilities";
import Pictogram from "./Pictogram.astro";
import SalaBoard from "./SalaBoard.astro";
import RouteBranch from "./RouteBranch.astro";
import Comprobante from "./Comprobante.astro";
import Instalacion from "./Instalacion.astro";

const DEMOS: Record<string, "sala" | "ruteo" | "instalacion" | "comprobante"> = {
  agentes: "sala",
  bandeja: "ruteo",
  conectar: "instalacion",
  numeros: "comprobante",
};
---

<section class="caps" id="producto">
  <header class="caps-head">
    <h2 class="sign caps-title">Lo que haces con Develar.</h2>
  </header>

  {
    CAPABILITIES.map((cap, i) => {
      const demo = DEMOS[cap.id];
      return (
        <article class="cap" id={cap.id} style={`--i:${i}`}>
          <div class="cap-text">
            <h3 class="sign cap-name">
              <span class="cap-mark" aria-hidden="true">
                <Pictogram name={cap.pictogram} size={24} />
              </span>
              {cap.name}
            </h3>
            <p class="cap-headline">{cap.headline}</p>
            <ul class="cap-list">
              {cap.points.map((point) => (
                <li>
                  <span class="cap-tick" aria-hidden="true" />
                  {point}
                </li>
              ))}
            </ul>
          </div>

          <div class="cap-demo">
            {demo === "sala" && <SalaBoard />}
            {demo === "ruteo" && <RouteBranch />}
            {demo === "instalacion" && <Instalacion />}
            {demo === "comprobante" && <Comprobante />}
          </div>
        </article>
      );
    })
  }

</section>

<style>
  .caps {
    display: grid;
    gap: clamp(2.25rem, 5vh, 3.5rem);
    padding-block: clamp(2.5rem, 6vh, 4rem);
  }

  .caps-title {
    margin: 0;
    font-size: clamp(1.75rem, 4.2vw, 3rem);
    color: var(--color-bone);
  }

  .cap {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-top: clamp(1.5rem, 3.5vh, 2.25rem);
    border-top: var(--stroke-thin) solid var(--color-rule);
  }

  .cap-text {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .cap-name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    color: var(--color-bone);
  }

  .cap-mark {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--color-emerald) 18%, transparent);
    border: var(--stroke-thin) solid color-mix(in oklab, var(--color-leaf) 28%, transparent);
    color: var(--color-leaf);
  }

  .cap-headline {
    margin: 0.15rem 0 0;
    font-weight: 600;
    font-size: clamp(1.0625rem, 1.9vw, 1.35rem);
    line-height: 1.3;
    color: var(--color-lime);
    max-width: 26ch;
    text-wrap: balance;
  }


  .cap-list {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-size: 0.875rem;
    color: var(--color-bone-dim);
  }

  .cap-list li {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .cap-tick {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--color-leaf);
  }

  .cap-demo {
    min-width: 0;
  }


  @media (min-width: 62rem) {
    .cap {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: center;
    }

    /* Alternate which side the demonstration sits on, so four blocks in a row
       do not read as four copies of one layout. */
    .cap:nth-child(odd) .cap-text {
      order: 2;
    }
    .cap:nth-child(odd) .cap-demo {
      order: 1;
    }

  }
</style>
