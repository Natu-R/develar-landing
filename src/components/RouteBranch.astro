---
/**
 * Station 04 — the three-level number selection chain, drawn as an interchange.
 *
 * Built in HTML rather than a scaling SVG: a diagram whose labels shrink with
 * the viewport is a diagram nobody can read on a phone. The trunk and its
 * connectors are drawn in CSS at the line's own weight, so the notation holds
 * at any width while the type stays at its real size.
 *
 * Level 1 has no open shift, so the chain falls to level 2. Level 3 stands by.
 * Source: develar/docs/agent-selection-levels.md
 */
const LEVELS = [
  { n: "N1", name: "Agente en turno", state: "sin turno abierto", taken: false },
  { n: "N2", name: "Agente con WhatsApp enlazado", state: "toma el contacto", taken: true },
  { n: "N3", name: "Número de respaldo", state: "en reserva", taken: false },
] as const;
---

<figure class="branch">
  <ol class="branch-levels">
    {
      LEVELS.map((level) => (
        <li class={level.taken ? "branch-level is-taken" : "branch-level"}>
          <span class="branch-node" aria-hidden="true">
            {!level.taken && (
              <svg viewBox="0 0 16 16" class="branch-skip" aria-hidden="true">
                <path d="M4 4 L12 12 M12 4 L4 12" />
              </svg>
            )}
          </span>
          <span class="branch-code plate">{level.n}</span>
          <span class="branch-name sign-sm">{level.name}</span>
          <span class="branch-state plate">{level.state}</span>
        </li>
      ))
    }
  </ol>

  <figcaption class="note branch-caption">
    Si no hay ningún agente libre, entra el número de respaldo. · Ejemplo
  </figcaption>
</figure>

<style>
  .branch {
    margin: 0.75rem 0 0;
    display: grid;
    gap: 1.25rem;
    width: 100%;
  }

  .branch-levels {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 2.5rem;
    display: grid;
    gap: 0;
    max-width: 34rem;
  }

  /* The trunk: one run down the interchange, entering lime and leaving at the
     level that answers. */
  .branch-levels::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.55rem;
    bottom: 1.55rem;
    width: var(--stroke);
    border-radius: var(--radius-pill);
    background: linear-gradient(
      to bottom,
      var(--color-emerald),
      var(--color-leaf)
    );
  }

  .branch-level {
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.85rem;
    row-gap: 0.15rem;
    padding: 0.85rem 0;
    border-bottom: var(--stroke-thin) solid var(--color-rule);
  }

  .branch-level:first-child {
    border-top: var(--stroke-thin) solid var(--color-rule);
  }

  /* The connector from the trunk into this level's platform. */
  .branch-level::before {
    content: "";
    position: absolute;
    left: -2.5rem;
    top: 50%;
    width: 2.1rem;
    height: var(--stroke);
    transform: translateY(-50%);
    border-radius: var(--radius-pill);
    background: var(--color-rule-strong);
  }

  .branch-level.is-taken::before {
    background: var(--color-leaf);
  }

  .branch-node {
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: inset 0 0 0 3px var(--color-rule-strong);
    color: var(--color-bone-mute);
  }

  .is-taken .branch-node {
    box-shadow: inset 0 0 0 4px var(--color-leaf);
  }

  .branch-skip {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: square;
  }

  .branch-code {
    font-size: 0.6875rem;
    color: var(--color-bone-mute);
  }

  .is-taken .branch-code {
    color: var(--color-leaf);
  }

  .branch-name {
    font-size: 0.9375rem;
    color: var(--color-bone-dim);
    letter-spacing: 0.035em;
  }

  .is-taken .branch-name {
    color: var(--color-bone);
  }

  .branch-state {
    grid-column: 3;
    font-size: 0.6875rem;
    color: var(--color-bone-mute);
  }

  .is-taken .branch-state {
    color: var(--color-leaf);
  }

  .branch-caption {
    max-width: 52ch;
  }

  @media (min-width: 34rem) {
    .branch-level {
      grid-template-columns: auto auto minmax(0, 1fr) auto;
      column-gap: 1rem;
    }
    .branch-state {
      grid-column: 4;
      text-align: right;
    }
  }
</style>
