---
/**
 * The primary action, issued as a ticket. The notches are cut with a mask, not
 * drawn, so the edge stays a real perforation at any zoom.
 */
import { SITE, whatsappHref } from "../data/site";
import Pictogram from "./Pictogram.astro";

interface Props {
  label?: string;
  note?: string;
  class?: string;
}

const { label = "Escríbenos por WhatsApp", note, class: className = "" } = Astro.props;

// Until a real number is configured the stub carries the line's own identity.
// Printing a plausible-looking placeholder on the page's only conversion path
// would be a fabricated fact, and a visitor who copies it reaches nothing.
const stub = note ?? (SITE.whatsappDisplay || "Línea 01");
---

<a class={`ticket brand-button punched ${className}`} href={whatsappHref} rel="noopener">
  <span class="ticket-main">
    <Pictogram name="whatsapp" size={26} />
    <span class="ticket-label sign-sm">{label}</span>
  </span>
  <span class="ticket-stub plate">
    <span class="ticket-stub-line">Válido</span>
    <span class="ticket-stub-line">{stub}</span>
  </span>
</a>

<style>
  .ticket {
    --punch: 10px;
    display: inline-grid;
    grid-template-columns: 1fr auto;
    align-items: stretch;
    gap: 0;
    text-decoration: none;
    min-height: 4.5rem;
    max-width: 100%;
    border-radius: var(--radius-pill);
  }

  .ticket-main {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0 1.4rem 0 1.65rem;
  }

  .ticket-label {
    font-size: clamp(0.875rem, 1.6vw, 1.15rem);
    letter-spacing: 0.01em;
    /* A control names its action on one line or it is the wrong control. */
    white-space: nowrap;
  }

  .ticket-stub {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    gap: 0.2rem;
    padding: 0 1.6rem 0 1.1rem;
    font-size: 0.6875rem;
    line-height: 1.3;
    text-align: right;
    border-left: var(--stroke-thin) dashed color-mix(in oklab, var(--color-ink-deep) 45%, transparent);
    color: color-mix(in oklab, var(--color-ink-deep) 72%, transparent);
  }

  .ticket-stub-line {
    white-space: nowrap;
  }

  .ticket-stub-line:last-child {
    color: var(--color-ink-deep);
    letter-spacing: 0.04em;
  }

  /* Narrow: the stub moves below the fold line instead of squeezing the
     action into three lines. Same ticket, torn the other way. */
  @media (max-width: 30rem) {
    .ticket {
      grid-template-columns: 1fr;
      --punch: 8px;
      border-radius: var(--radius-pill);
    }

    .ticket-main {
      padding: 1rem 1.25rem 0.9rem;
    }

    .ticket-stub {
      border-left: 0;
      border-top: var(--stroke-thin) dashed
        color-mix(in oklab, var(--color-ink-deep) 45%, transparent);
      text-align: left;
      padding: 0.75rem 1.25rem 0.95rem;
      grid-auto-flow: column;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }
  }

</style>
